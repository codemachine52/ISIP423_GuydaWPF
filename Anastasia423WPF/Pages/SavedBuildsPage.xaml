<Page x:Class="Anastasia423WPF.Pages.SavedBuildsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Сохраненные сборки">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Назад" Padding="10,5" Margin="0,0,15,0" Click="BtnBack_Click"/>
            <TextBlock Text="Список сохраненных сборок" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <ListView x:Name="LwAssemblies" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10" Background="White">
                        <StackPanel>
                            <TextBlock Text="{Binding name}" FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="{Binding author, StringFormat='Автор: {0}'}" Foreground="Gray" Margin="0,0,0,5"/>

                            <TextBlock Text="Комплектующие привязаны в БД" FontStyle="Italic" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>