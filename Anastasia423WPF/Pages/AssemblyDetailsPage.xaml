<Page x:Class="Anastasia423WPF.Pages.AssemblyDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
     Title="Детали сборки">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Content="Назад" Width="80" HorizontalAlignment="Left" Click="BtnBack_Click" Padding="5"/>

        <StackPanel Grid.Row="1" Margin="0,15,0,10">
            <TextBlock x:Name="TxtAssemblyName" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="TxtAuthor" FontSize="14" Foreground="Gray"/>
        </StackPanel>

        <ListView Grid.Row="2" x:Name="PartsListView" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{Binding image}" Width="70" Height="70" Stretch="Uniform"/>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding name}" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding price, StringFormat={}{0:N0} руб.}" 
                                   FontSize="16" FontWeight="Bold" Foreground="DarkGreen" 
                                   VerticalAlignment="Center" Margin="10,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock Text="Итого: " FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="TxtTotalPrice" FontSize="20" FontWeight="Bold" Foreground="DarkGreen"/>
        </StackPanel>
    </Grid>
</Page>