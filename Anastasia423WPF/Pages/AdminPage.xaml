<Page x:Class="Anastasia423WPF.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFFFF6CD" Offset="0"/>
                <GradientStop Color="#FFE47979" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Панель управления" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#FF6F1717"/>

            <TabControl Grid.Row="1" Background="#66FFFFFF" BorderThickness="0">
                <TabItem Header="Товары" Width="150" Height="30">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                                <DataGridTextColumn Header="Скидка" Binding="{Binding Discount}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Добавить" Width="100" Margin="5" Click="AddProduct_Click"/>
                            <Button Content="Редактировать" Width="100" Margin="5" Click="EditProduct_Click"/>
                            <Button Content="Удалить" Width="100" Margin="5" Background="#FF6F1717" Foreground="White" Click="DeleteProduct_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem x:Name="UsersTab" Header="Пользователи" Width="150" Height="30">
                    <Grid Margin="10">
                        <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Роль" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox x:Name="RoleCombo" 
                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=AllRoles}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="ID"
                                                      SelectedValue="{Binding RoleID, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectionChanged="RoleCombo_SelectionChanged"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Button Grid.Row="2" Content="Назад в каталог" Width="150" Height="35" HorizontalAlignment="Left" Click="Back_Click"/>
        </Grid>
    </Grid>
</Page>