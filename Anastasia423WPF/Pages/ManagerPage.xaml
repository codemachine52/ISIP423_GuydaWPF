<Page x:Class="Anastasia423WPF.Pages.ManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Панель менеджера">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFFFF6CD" Offset="0"/>
                <GradientStop Color="#FFE47979" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <TabControl Margin="10" Background="#33FFFFFF">
            <TabItem Header="Управление заказами">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                              Margin="5" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding ID}" Width="50"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding User.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                            <DataGridTextColumn Header="Дата доставки" Binding="{Binding DeliveryDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                            <DataGridTextColumn Header="Оплата" Binding="{Binding PaymentType}" Width="150"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                        <Button Content="Просмотреть состав" Width="150" Height="35" Margin="5" Click="ViewDetails_Click"/>
                        <Button Content="ВЫДАТЬ ЗАКАЗ" Width="150" Height="35" Margin="5" 
                                Background="#FF0F3E25" Foreground="White" Click="IssueOrderBtn_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Записи на услуги">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="AppointmentsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата/Время" Binding="{Binding AppointmentDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding User.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Услуга" Binding="{Binding Service.Name}" Width="*"/>
                            <DataGridTextColumn Header="Мастер" Binding="{Binding User1.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <Button Content="Новая запись" Width="120" Height="35" Margin="5" Click="AddApt_Click"/>
                        <Button Content="Перенести" Width="120" Height="35" Margin="5" Click="EditApt_Click"/>
                        <Button Content="Отменить" Width="120" Height="35" Margin="5" Click="CancelApt_Click"/>
                        <Button Content="Удалить" Width="120" Height="35" Margin="5" Click="DeleteApt_Click" 
                                Background="#FF803F3F" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
