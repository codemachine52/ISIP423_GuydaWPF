<Page x:Class="Anastasia423WPF.Pages.MasterCabinetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Кабинет мастера">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFFFF6CD" Offset="0"/>
                <GradientStop Color="#FFE47979" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel Margin="30">
            <Border Background="#66FFFFFF" CornerRadius="15" Padding="20" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="60" Height="60" Fill="#FF803F3F" Margin="0,0,20,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding FIO, StringFormat='Мастер: {0}'}" FontSize="22" FontWeight="Bold" Foreground="#FF383131"/>
                        <TextBlock Text="Ваше расписание на ближайшее время" FontSize="14" Foreground="#FF513030"/>
                    </StackPanel>
                    <Button x:Name="LogOutButton" Content="Выход из аккаунта" Padding="5" HorizontalAlignment="Right" Height="30" Margin="50, 0, 0, 0"
                            Background="#FF6F1717" Foreground="White" Click="LogOutButton_Click"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Записи к вам:" FontSize="20" FontWeight="Bold" Margin="5,0,0,10" Foreground="White"/>

            <ListView x:Name="ScheduleList" Height="400" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#CCFFFFFF" CornerRadius="12" Margin="0,5" Padding="15">
                            <Grid Width="700">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppointmentDate, StringFormat={}{0:dd MMMM}}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding AppointmentDate, StringFormat={}{0:HH:mm}}" FontSize="14" Foreground="Gray"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                                    <TextBlock Text="{Binding Service.Name}" FontSize="16" FontWeight="Bold" Foreground="#FF803F3F"/>
                                    <TextBlock Text="{Binding User.FIO, StringFormat='Клиент: {0}'}" FontSize="14"/>
                                    <TextBlock Text="{Binding Comment, StringFormat='Прим: {0}'}" FontSize="12" FontStyle="Italic" Foreground="DimGray"/>
                                </StackPanel>

                                <Border Grid.Column="2" Padding="10,5" CornerRadius="5" Background="#FF6F1717" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>