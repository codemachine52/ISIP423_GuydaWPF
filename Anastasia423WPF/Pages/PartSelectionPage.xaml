<Page x:Class="Anastasia423WPF.Pages.PartSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Выбор комплектующего">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Назад" Grid.Column="0" Padding="10,5" Margin="0,0,15,0" Click="BtnBack_Click" Width="100" FontSize="18"/>

            <TextBox x:Name="TxtSearch" Grid.Column="1" Padding="5" Margin="0,0,10,0" TextChanged="FilterChanged"/>
            <TextBlock Text="Производитель:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="18"/>
            <ComboBox x:Name="CmbManufacturers" Grid.Column="3" DisplayMemberPath="name" SelectionChanged="FilterChanged" FontSize="16"/>
        </Grid>

        <ListView x:Name="LwParts" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding image}" Width="100" Height="100" Stretch="Uniform" Margin="0,0,15,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding name}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding manufacturer_.name}" Foreground="Gray" Margin="0,2,0,5"/>

                                <TextBlock Text="{Binding DisplayDetails}" Foreground="DimGray" FontWeight="Medium" Margin="0,5,0,0"/>
                                <Button Content="Выбрать" Padding="15,5" Click="Button_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>