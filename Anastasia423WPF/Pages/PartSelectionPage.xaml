<Page x:Class="Anastasia423WPF.Pages.PartSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Выбор комплектующего">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Назад" Grid.Column="0" Padding="10,5" Margin="0,0,15,0" Click="BtnBack_Click"/>

            <TextBox x:Name="TxtSearch" Grid.Column="1" Padding="5" Margin="0,0,10,0" TextChanged="FilterChanged"/>
            <TextBlock Text="Производитель:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="CmbManufacturers" Grid.Column="3" DisplayMemberPath="name" SelectionChanged="FilterChanged"/>
        </Grid>

        <ListView x:Name="LwParts" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10" Width="Auto" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding image}" Grid.Column="0" Width="70" Height="70" Stretch="UniformToFill" Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding name}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding manufacturer.name}" Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding price, StringFormat={}{0:C2}}" FontSize="18" FontWeight="Bold" Foreground="DarkGreen" Margin="0,0,0,5"/>
                                <Button Content="Выбрать" Padding="15,5" Click="BtnSelectPart_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>