<Page x:Class="Anastasia423WPF.Pages.SavedBuildsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Текущая сборка"
      >
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Новая сборка ПК" FontSize="28" FontWeight="Light" Margin="0,0,0,20"/>

        <Button Grid.Column="1" Content="Архив сборок" HorizontalAlignment="Right" 
                Padding="15,5" Click="BtnViewSaved_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>

        <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="0,0,20,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CategoriesItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="10,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="Gray" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="18" Margin="0,5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPart}" Value="{x:Null}">
                                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DisplayPrice}" Foreground="DarkGreen" FontWeight="Medium"/>
                                </StackPanel>

                                <Button Grid.Column="1" VerticalAlignment="Center" Padding="20,8"
                                        Click="BtnSelect_Click" Tag="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Изменить"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPart}" Value="{x:Null}">
                                                    <Setter Property="Content" Value="Выбрать"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1" Background="#F9F9F9" CornerRadius="10" Padding="20" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Резюме сборки" FontSize="20" Margin="0,0,0,15"/>

                <TextBlock Text="Итоговая стоимость:" Foreground="Gray"/>
                <TextBlock x:Name="TxtTotalPrice" Text="0 руб." FontSize="32" FontWeight="Bold" Foreground="#FF3D70A4" Margin="0,5,0,20"/>

                <TextBlock Text="Название конфигурации" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtBuildName" Margin="0,0,0,15" Padding="8"/>

                <TextBlock Text="Автор" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtAuthorName" Margin="0,0,0,25" Padding="8"/>

                <Button Content="СОХРАНИТЬ В БАЗУ" Background="#FF487159" Foreground="White" FontWeight="Bold" 
                        Padding="15" Click="BtnSaveBuild_Click"/>
                <Button Content="Очистить всё" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" 
                         Click="BtnClear_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>