<Page x:Class="BuilderPC.CurrentBuildPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Текущая сборка">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ваша сборка ПК" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
        <Button Grid.Column="1" Content="Посмотреть сохраненные сборки" HorizontalAlignment="Right" Padding="10,5" Click="BtnViewSaved_Click"/>

        <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
            <StackPanel x:Name="CategoriesPanel" />
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1" Background="#F0F0F0" CornerRadius="5" Padding="15">
            <StackPanel>
                <TextBlock Text="Итого:" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="TxtTotalPrice" Text="0 руб." FontSize="24" Foreground="DarkGreen" Margin="0,10,0,20"/>

                <TextBlock Text="Название сборки:"/>
                <TextBox x:Name="TxtBuildName" Margin="0,5,0,10" Padding="5"/>

                <TextBlock Text="Имя автора:"/>
                <TextBox x:Name="TxtAuthorName" Margin="0,5,0,20" Padding="5"/>

                <Button Content="Сохранить сборку" Padding="10" Click="BtnSaveBuild_Click"/>
                <Button Content="Очистить сборку" Padding="10" Margin="0,10,0,0" Click="BtnClear_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>