<Page x:Class="Anastasia423WPF.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Корзина">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFFFF6CD" Offset="0"/>
                <GradientStop Color="#FFE47979" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel Margin="20">
            <TextBlock Text="Ваш заказ" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <ListBox x:Name="CartList" Height="300" Background="#66FFFFFF" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="600" Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Image}" Height="50" Width="50"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat={}{0} ₽}" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Background="#33000000" Padding="15" Margin="0,20,0,0" CornerRadius="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Итого к оплате: " FontSize="20" Foreground="White"/>
                    <TextBlock x:Name="TotalSumText" FontSize="22" FontWeight="Bold" Foreground="Yellow"/>
                </StackPanel>
            </Border>

            <UniformGrid Columns="2" Margin="0,20,0,0">
                <Button Content="Назад" Click="Back_Click" Height="40" Margin="5"/>
                <Button Content="Оформить заказ" Click="Order_Click" Height="40" Margin="5" Background="#FF0F3E25" Foreground="White"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Page>