<Page x:Class="Pr12.Pages.Credit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Credit">

    <Grid>
        <StackPanel>
            <TextBlock Margin="5" TextAlignment="Center" Text="Расчёт Кредита" FontSize="20" FontWeight="Bold"/>
            <TextBlock Margin="5" TextAlignment="Center" Text="Процент первоначального взноса"/>
            <TextBox x:Name="Percent" Margin="5" Width="100" TextChanged="Percent_TextChanged"></TextBox>
            <TextBlock Margin="5" TextAlignment="Center" Text="Срок Кредита (12-36 мес.)"/>
            <TextBox x:Name="months" Margin="5" Width="100" TextChanged="months_TextChanged">12</TextBox>
            <Button Margin="5" Width="100" Height="20" Click="Button_Click">Подтвердить</Button>
            <TextBlock x:Name="vznos" Margin="5" TextAlignment="Center" Text="Первоначальный взнос: "/>
            <TextBlock x:Name="Summa" Margin="5" TextAlignment="Center" Text="Сумма в кредит: "/>
            <TextBlock x:Name="monthly" Margin="5" TextAlignment="Center" Text="Ежемесячный платеж: "/>
        </StackPanel>
    </Grid>
</Page>
