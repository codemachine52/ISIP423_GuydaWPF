<Page x:Class="Pr12.Pages.Choices"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Choices">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"/>
            <ColumnDefinition Width="200*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="1"  Background="AliceBlue">
            <TextBlock TextAlignment="Center" Text="Общая стоимость:" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="TotalPrice" TextAlignment="Center" Text="" FontSize="20" FontWeight="Bold"/>
        </StackPanel>
        <Button Grid.Column="0" Grid.Row="1" Width="120" Height="25" Margin="25" VerticalAlignment="Bottom" Click="Button_Click">Оформить Кредит</Button>
        <StackPanel Grid.Column="1" Grid.Row="1">
            <TextBlock x:Name="ModelText" HorizontalAlignment="Center" Text="Модель: " Margin="5"/>
            <TextBlock x:Name="EngineText" HorizontalAlignment="Center" Text="Двигатель: " Margin="5"/>
            <TextBlock x:Name="ColorText" HorizontalAlignment="Center" Text="Цвет: " Margin="5"/>
            <TextBlock x:Name="MoreText" HorizontalAlignment="Center" Text="Доп. опции:" Margin="5"/>
        </StackPanel>
    </Grid>
</Page>
