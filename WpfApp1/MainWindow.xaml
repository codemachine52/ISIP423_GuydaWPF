<Window x:Class="RoguelikeWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roguelike Game" Height="600" Width="800"
        Background="#F5F5F5">

    <Grid>
        
        <!--окно приветствия игрока, оно же главное меню-->
        <Grid x:Name="StartMenu" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="C# ROGUELIKE" FontSize="48" FontWeight="Bold" Margin="0,0,0,30" TextAlignment="Center"/>
                <Button Content="Начать игру" FontSize="24" Padding="20,10" Click="BtnStart_Click" />
            </StackPanel>
        </Grid>

        <!--окно проигрыша-->
        <Grid x:Name="GameOverScreen" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="ВЫ ПОГИБЛИ" FontSize="48" FontWeight="Bold" Foreground="DarkRed" Margin="0,0,0,30" TextAlignment="Center"/>
                <Button Content="Начать заново" FontSize="24" Padding="20,10" Click="BtnStart_Click" />
            </StackPanel>
        </Grid>
        
        <!--окно где происходит сама игра и действия в ней-->
        <Grid x:Name="GameScreen" Visibility="Collapsed" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <!--отображение хп, этажа и статуса (заморожен либо нет текста, если не заморожен)-->
            <Border Grid.Row="0" BorderBrush="Black" BorderThickness="2" CornerRadius="5" Padding="10" Margin="0,0,0,10" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="TxtFloor" Grid.Column="0" Text="Этаж: 1" FontSize="18" FontWeight="Bold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Здоровье: " FontSize="18"/>
                        <TextBlock x:Name="TxtHP" Text="100/100" FontSize="18" FontWeight="Bold" Foreground="Green"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtStatus" Grid.Column="2" Text="" FontSize="18" Foreground="Blue"/>
                </Grid>
            </Border>


            <!--экран игры (комната, бой с врагами, нахождение лута)-->
            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Background="White" Margin="0,0,0,10" ClipToBounds="True">
                <Grid>
                    <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.8"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--изображение лута в комнате-->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="RoomImage" Stretch="Uniform" Margin="10" Height="180"/>
                            <Image x:Name="LootImage" Stretch="Uniform" Margin="10" Height="120" Visibility="Collapsed"/>
                        </StackPanel>

                        <!--бой с врагом (выбор атака/защита)-->
                        <Border Grid.Row="1" Background="#AA000000" Padding="15">
                            <StackPanel>
                                <TextBlock x:Name="TxtRoomContent" Text="" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                <StackPanel x:Name="CombatPanel" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Атака" Width="120" Height="40" Margin="10,0" Click="BtnAttack_Click"/>
                                    <Button Content="Защита" Width="120" Height="40" Margin="10,0" Click="BtnDefend_Click"/>
                                </StackPanel>

                                <!--нахождение лута (с выбором выкинуть или оставить себе)-->
                                <StackPanel x:Name="LootPanel" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtLootInfo" Text="" FontSize="18" Foreground="White" TextAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Забрать" Width="120" Height="40" Margin="10,0" Click="BtnTakeLoot_Click"/>
                                        <Button Content="Выбросить" Width="120" Height="40" Margin="10,0" Click="BtnDropLoot_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!--текущий инвент игрока-->
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Margin="0,0,5,0" Background="White" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Инвентарь" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtWeapon" Text="Оружие: Кулаки (Урон 0)" FontSize="16" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TxtArmor" Text="Броня: Одежда (Защита 0)" FontSize="16" Margin="0,5,0,0"/>
                        <TextBlock x:Name="TxtBaseStats" Text="Базовая Атака: 10 | Защита: 5" FontSize="14" Foreground="Gray" Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Margin="5,0,0,0" Background="White">
                    <ListBox x:Name="ListLog" Margin="5" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>