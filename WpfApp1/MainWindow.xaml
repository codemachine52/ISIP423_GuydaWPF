<Window x:Class="SalaryCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вычисление заработной платы" Height="250" Width="450" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,10,0,10">
            <Label Content="Количество часов:"/>
            <TextBox x:Name="HoursTextBox" Width="80" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </StackPanel>

        <GroupBox Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Header="Преподаватель" Margin="10,0,0,10" Width="150">
            <StackPanel Margin="5">
                <RadioButton x:Name="AssistantRadio" Content="ассистент" IsChecked="True" Margin="0,5"/>
                <RadioButton x:Name="DocentRadio" Content="доцент" Margin="0,5"/>
                <RadioButton x:Name="ProfessorRadio" Content="профессор" Margin="0,5"/>
            </StackPanel>
        </GroupBox>

        <CheckBox x:Name="TaxCheckBox" Grid.Row="1" Grid.Column="0" Content="Подоходный налог (13%)" VerticalAlignment="Center" Margin="5,10,0,10"/>

        <Button x:Name="CalculateButton" Grid.Row="2" Grid.Column="2" Content="Вычислить" Width="100" Height="30" HorizontalAlignment="Right" Margin="0,10,10,0" Click="CalculateButton_Click"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,10,0,0">
            <Label x:Name="AccruedLabel" Content="Начислено: " FontWeight="Bold"/>
            <Label x:Name="TaxLabel" Content="в том числе налог: "/>
        </StackPanel>
    </Grid>
</Window>