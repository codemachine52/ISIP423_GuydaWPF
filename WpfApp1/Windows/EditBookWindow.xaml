<Window x:Class="WpfApp1.Windows.EditBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Windows"
        mc:Ignorable="d"
        Title="Редактор книги" Height="450" Width="800">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Название книги:"/>
            <TextBox x:Name="TBoxName" Margin="0,5,0,10"/>

            <TextBlock Text="Описание (аннотация):"/>
            <TextBox x:Name="TBoxDescription" Height="60" TextWrapping="Wrap" Margin="0,5,0,10"/>

            <TextBlock Text="Ссылка на обложку (путь к картинке):"/>
            <TextBox x:Name="TBoxPicture" Margin="0,5,0,10"/>

            <TextBlock Text="Текст произведения:" FontWeight="Bold"/>
            <TextBox x:Name="TBoxContent" Height="250" Margin="0,5,0,15" 
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="80" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Сохранить" Width="120" Background="#FF27A6AF" 
                        Foreground="White" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
