<Window x:Class="WpfApp1.Windows.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Windows"
        mc:Ignorable="d"
        Title="RegistrationWindow" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF2D2D4A" Offset="0"/>
                <GradientStop Color="#FF153F75" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
            <TextBlock FontSize="28" FontWeight="Thin" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20">Создать аккаунт</TextBlock>

            <TextBlock Foreground="White" Margin="0,5">Логин</TextBlock>
            <TextBox x:Name="LoginText" Height="30" Background="#B2FFFFFF" LostFocus="LoginText_LostFocus"/>
            <TextBlock x:Name="LoginError" Foreground="#FFFF6B6B" FontSize="11" Visibility="Collapsed"/>

            <TextBlock Foreground="White" Margin="0,10,0,5">Пароль</TextBlock>
            <PasswordBox x:Name="PassText" Height="30" Background="#B2FFFFFF" LostFocus="PassText_LostFocus"/>
            <TextBlock x:Name="PassError" Foreground="#FFFF6B6B" FontSize="11" Visibility="Collapsed"/>

            <TextBlock Foreground="White" Margin="0,10,0,5">Подтвердите пароль</TextBlock>
            <PasswordBox x:Name="PassVerificText" Height="30" Background="#B2FFFFFF" LostFocus="PassVerificText_LostFocus"/>
            <TextBlock x:Name="PassVerificError" Foreground="#FFFF6B6B" FontSize="11" Visibility="Collapsed"/>

            <TextBlock Foreground="White" Margin="0,10,0,5">ФИО</TextBlock>
            <TextBox x:Name="FIOText" Height="30" Background="#B2FFFFFF" LostFocus="FIOText_LostFocus"/>
            <TextBlock x:Name="FIOError" Foreground="#FFFF6B6B" FontSize="11" Visibility="Collapsed"/>

            <TextBlock Foreground="White" Margin="0,10,0,5">Email</TextBlock>
            <TextBox x:Name="EmailText" Height="30" Background="#B2FFFFFF" LostFocus="PhoneText_LostFocus"/>
            <TextBlock x:Name="EmailError" Foreground="#FFFF6B6B" FontSize="11" Visibility="Collapsed"/>

            <Button x:Name="RegistrUser" Height="40" Margin="0,30,0,10" Background="#FF27A6AF" Foreground="White" FontWeight="Bold" Click="RegistrUser_Click" Content="Зарегистрироваться"/>
            <Button x:Name="Back" Background="Transparent" BorderThickness="0" Foreground="Gray" Content="Назад ко входу" Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Window>
