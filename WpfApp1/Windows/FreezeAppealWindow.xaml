<Window x:Class="WpfApp1.Windows.FreezeAppealWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аккаунт заморожен" Height="400" Width="400" 
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="White">
    <Grid Margin="20">
        <StackPanel Margin="20">
            <TextBlock x:Name="TitleAccount" Text="Ваш аккаунт заморожен" 
               FontSize="22" FontWeight="Bold" Foreground="#FF5555" 
               HorizontalAlignment="Center" Margin="0,0,0,10"
               Visibility="{Binding AccountTitleVisibility}"/>

            <TextBlock x:Name="TitleBook" Text="Ваше произведение заморожено" 
               FontSize="22" FontWeight="Bold" Foreground="#FFFFB800" 
               HorizontalAlignment="Center" Margin="0,0,0,10"
               Visibility="{Binding BookTitleVisibility}"/>

            <TextBlock Text="Причина:" FontSize="14" Foreground="White" Margin="0,10,0,5"/>
            <Border Background="#33FFFFFF" Padding="10" CornerRadius="5">
                <TextBlock x:Name="TBlockReason" Foreground="LightGray" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="Текст апелляции:" FontSize="14" Foreground="White" Margin="0,20,0,5"/>
            <TextBox x:Name="TBoxAppeal" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
             Background="#44000000" Foreground="White" BorderBrush="#33FFFFFF"/>

            <Button Content="Отправить апелляцию" Click="BtnSend_Click" 
            Margin="0,20,0,0" Height="40" Background="#FF27A6AF" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>