<Window x:Class="WpfApp1.Windows.FreezeAppealWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аккаунт заморожен" Height="400" Width="400" 
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="White">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Ваш аккаунт заморожен" FontSize="22" FontWeight="Bold" 
                       Foreground="#FF5555" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="Причина заморозки:" FontSize="14" Margin="0,10,0,5"/>
            <Border Background="#2D2D2D" Padding="10" CornerRadius="5">
                <TextBlock x:Name="TBlockReason" TextWrapping="Wrap" Foreground="LightGray"/>
            </Border>

            <TextBlock Text="Текст апелляции (почему вас должны разморозить):" 
                       FontSize="14" Margin="0,20,0,5"/>
            <TextBox x:Name="TBoxAppeal" Height="100" TextWrapping="Wrap" 
                     AcceptsReturn="True" Background="#2D2D2D" Foreground="White" 
                     BorderThickness="1" BorderBrush="#444"/>

            <Button Content="Отправить апелляцию" Click="BtnSend_Click" 
                    Margin="0,20,0,0" Height="40" Background="#444" Foreground="White">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Отмена" Click="BtnCancel_Click" Margin="0,10,0,0" 
                    Background="Transparent" BorderThickness="0" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>