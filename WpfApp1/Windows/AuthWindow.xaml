<Window x:Class="WpfApp1.Windows.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
       Title="Авторизация - Читай, Пиши и не спиши" Height="450" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#FF5F572D" Offset="0"/>
                <GradientStop Color="#CC230F12" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Padding="20" FontSize="30" FontWeight="Thin" Foreground="White" HorizontalAlignment="Center">Войдите в аккаунт</TextBlock>

            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,5" FontSize="18" FontWeight="Thin" Foreground="White">Логин</TextBlock>
            <TextBox x:Name="LoginText" Width="200" Height="30" Background="#B2FFFFFF" VerticalContentAlignment="Center"/>

            <TextBlock HorizontalAlignment="Center" Margin="0,15,0,5" FontSize="18" FontWeight="Thin" Foreground="White">Пароль</TextBlock>
            <PasswordBox x:Name="PassText" Width="200" Height="30" Background="#B2FFFFFF" VerticalContentAlignment="Center"/>

            <Button x:Name="Enter" Width="150" Height="35" Margin="0,25,0,0" Background="#FF27A6AF" FontWeight="SemiBold" Click="Enter_Click">Войти</Button>

            <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="14" FontWeight="Thin" Foreground="White">Нет аккаунта?</TextBlock>
            <Button x:Name="Registr" Foreground="LightBlue" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Registr_Click">Зарегистрируйтесь</Button>
        </StackPanel>
    </Grid>
</Window>
