<Window x:Class="WpfApp1.Windows.AddReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оставить отзыв" Height="350" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Ваша оценка (1-5):" Foreground="Black" Margin="0,0,0,5"/>
            <ComboBox x:Name="ComboRating" Width="60" HorizontalAlignment="Left" Margin="0,0,0,15">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="5" IsSelected="True"/>
            </ComboBox>

            <TextBlock Text="Текст отзыва:" Foreground="Black" Margin="0,0,0,5"/>
            <TextBox x:Name="TBoxReviewText" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Width="80" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Сохранить" Width="100" Background="#FF27A6AF" Foreground="White" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>