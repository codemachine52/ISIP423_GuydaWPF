<Window x:Class="WpfApp1.Windows.RoleRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Windows"
        mc:Ignorable="d"
        Title="Запрос на получение роли автора" Height="450" Width="800" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Текст запроса:" Foreground="Black" Margin="0,0,0,5" FontSize="16"/>
            <TextBox x:Name="TBoxReviewText" Height="150" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Width="80" FontSize="14" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Отправить" Width="100" FontSize="14" Background="#FF27A6AF" Foreground="White" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
