<Page x:Class="WpfApp1.Pages.Page4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page4">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FF1B68E4" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border Background="Bisque" CornerRadius="10" VerticalAlignment="Top">
            <TextBlock Text="Кинотеатр Мечта" VerticalAlignment="Top" Foreground="Black" FontWeight="Heavy"  FontSize="23" HorizontalAlignment="Left" Margin="20, 5"/>
        </Border>

        <Border Background="Bisque" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" Height="220" CornerRadius="12">
            <StackPanel>
                <TextBlock x:Name="usFIO" Text="Фио" FontStyle="Italic" FontWeight="DemiBold" FontSize="18" Margin="10"/>
                <TextBlock x:Name="usAge" Text="Возраст" FontStyle="Italic" FontWeight="DemiBold" FontSize="18" Margin="10, 0, 0, 0"/>
                <TextBlock Text="Страна" FontStyle="Italic" FontWeight="DemiBold" FontSize="18" Margin="10, 10, 0, 0"/>
                <Image Source="/Images/images.jfif" Width="40" Height="30" VerticalAlignment="Top" Margin="90, -25, 0, 0" HorizontalAlignment="Left"/>
                <TextBlock x:Name="usEmail" Text="E-mail" FontStyle="Italic" FontWeight="DemiBold" FontSize="18" Margin="10, 5, 10, 0"/>
                <TextBlock x:Name="usNumber" Text="Номер телефона" FontStyle="Italic" FontWeight="DemiBold" FontSize="18" Margin="10, 10, 10, 0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
