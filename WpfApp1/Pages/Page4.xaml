<Page x:Class="WpfApp1.Pages.Page4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page4">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FF1B68E4" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border Background="Bisque" CornerRadius="10" VerticalAlignment="Top">
            <TextBlock Text="Кинотеатр Мечта" VerticalAlignment="Top" Foreground="Black" FontWeight="Heavy"  FontSize="23" HorizontalAlignment="Left" Margin="20, 5"/>
        </Border>

        <Border x:Name="UsInfo" Background="Bisque" HorizontalAlignment="Center" Width="400" Height="180" CornerRadius="12" Margin="0, 30, 0, 0">
            <StackPanel>
                <TextBlock x:Name="FIOuser" Text="Фио: " FontStyle="Italic" FontWeight="DemiBold" FontSize="18" Margin="10"/>
                <TextBlock x:Name="AGEuser" Text="Возраст: " FontStyle="Italic" FontWeight="DemiBold" FontSize="18" Margin="10, 0, 0, 0"/>
                <TextBlock x:Name="EMAILuser" Text="E-mail: " FontStyle="Italic" FontWeight="DemiBold" FontSize="18" Margin="10, 10, 10, 0"/>
                <TextBlock x:Name="NUMBERuser" Text="Номер телефона: " FontStyle="Italic" FontWeight="DemiBold" FontSize="18" Margin="10, 10, 10, 0"/>
                <TextBlock x:Name="TicketUsers" Text="Активные билеты:" FontWeight="DemiBold" FontSize="18" Margin="10, 10, 10, 0"/>
            </StackPanel>
        </Border>
        <Button x:Name="GoBack" Content="Назад" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30" FontSize="18" Width="100" Background="#FF10D0B1" Foreground="White" Click="GoBack_Click"/>
    </Grid>
</Page>
