<Page x:Class="WpfApp1.Pages.ReadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Чтение книги">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Content="Назад в каталог" HorizontalAlignment="Left" Click="Back_Click" Background="Transparent" Foreground="LightBlue" BorderThickness="0"/>
            <TextBlock x:Name="TBlockBookName" FontSize="28" Foreground="White" FontWeight="Bold" Text="Название книги"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Background="#1A1A1A" Padding="15">
            <TextBlock x:Name="TBlockContent" Foreground="White" FontSize="16" TextWrapping="Wrap" Text="Здесь будет текст книги..."/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Написать отзыв и поставить оценку" 
            HorizontalAlignment="Left" Padding="15,5" 
            Background="#FF27A6AF" Foreground="White" 
            Click="OpenReviewWindow_Click"/>
        </StackPanel>
    </Grid>
</Page>