<Page x:Class="WpfApp1.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="Личный кабинет" FontSize="32" Foreground="White" Margin="0,0,0,20"/>

            <Border Background="#33FFFFFF" Padding="20" CornerRadius="10">
                <StackPanel>
                    <TextBlock x:Name="TBlockFIO" FontSize="20" Foreground="White" Text="ФИО: " Margin="0,5"/>
                    <TextBlock x:Name="TBlockEmail" FontSize="18" Foreground="LightGray" Text="Email: " Margin="0,5"/>
                    <TextBlock x:Name="TBlockRole" FontSize="16" Foreground="Gold" Text="Роль: " Margin="0,5"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Мои отзывы:" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,10"/>
            <ListBox x:Name="LBoxMyReviews" Height="250" Background="#10FFFFFF" BorderThickness="0" MouseDoubleClick="LBoxMyReviews_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="10" Width="600" Tag="{Binding BookID}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0">
                                    <TextBlock Text="Книга: " Foreground="Gray" FontSize="12"/>
                                    <TextBlock Text="{Binding BookName}" Foreground="Cyan" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text=" | Оценка: " Foreground="Gray" Margin="10,0,0,0" FontSize="12"/>
                                    <TextBlock Text="{Binding Rating}" Foreground="Yellow" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Description}" Grid.Row="1" 
                               Foreground="White" TextWrapping="Wrap" Margin="0,5,0,0" FontStyle="Italic"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal">
                <Button Name="ExitButton" HorizontalAlignment="Left" FontSize="14" Foreground="Honeydew" Background="LightCoral"  VerticalAlignment="Bottom" Content="Выйти из аккаунта" Padding="7" Margin="0, 20, 0, 0" Click="ExitButton_Click"/>
            <Button Name="RequestButton" HorizontalAlignment="Left" FontSize="14" Foreground="Honeydew" Background="DarkCyan"  VerticalAlignment="Bottom" Content="Заявка на роль автора" Padding="7" Margin="20, 0, 0, 0" Click="RequestButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>