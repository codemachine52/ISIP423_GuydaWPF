<Page x:Class="WpfApp1.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои книги" Loaded="Page_Loaded">
    <Grid Margin="20">
        <StackPanel>
            <Button Content="Добавить новую книгу" Width="200" HorizontalAlignment="Left" 
                    Margin="0,0,0,20" Click="BtnAddBook_Click" Background="#FF27A6AF" Foreground="White"/>

            <TextBlock Text="Мои публикации:" FontSize="20" Foreground="White" Margin="0,0,0,10"/>
            <ListBox x:Name="LBoxAuthorBooks" Height="400" Background="#33FFFFFF" 
         MouseDoubleClick="LBoxAuthorBooks_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="LightGray" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Rating}" Foreground="Gold" VerticalAlignment="Center" Margin="10,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>