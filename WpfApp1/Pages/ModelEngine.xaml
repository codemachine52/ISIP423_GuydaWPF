<Page x:Class="Pr12.Pages.ModelEngine"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ModelEngine">

    <Grid>
        <StackPanel>
            <TextBlock HorizontalAlignment="Center" Text="Выберите модель:" Margin="5"/>
            <ComboBox x:Name="ModelComboBox" Width="100" SelectionChanged="ModelComboBox_SelectionChanged"/>
            <TextBlock x:Name="ModelCost" HorizontalAlignment="Center" Text="Стоимость: 187000" Margin="5" FontWeight="Bold"/>
            <TextBlock HorizontalAlignment="Center" Text="Выберите вид двигателя:" Margin="5"/>
            <ComboBox x:Name="EngineComboBox" Width="100" SelectionChanged="EngineComboBox_SelectionChanged"/>
            <TextBlock x:Name="EngineCost" HorizontalAlignment="Center" Text="Стоимость: 187000" Margin="5" FontWeight="Bold"/>
            <Button x:Name="NextButton" HorizontalAlignment="Center" Content="Далее" Click="NextButton_Click" Margin="5"/>
            <TextBlock x:Name="TotalCost" HorizontalAlignment="Center" Text="Общая Стоимость: 187000" Margin="5" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>
