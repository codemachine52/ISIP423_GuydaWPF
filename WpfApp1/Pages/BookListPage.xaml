<Page x:Class="WpfApp1.Pages.BookListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Списки чтения" Loaded="Page_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Мои списки" FontSize="28" Foreground="White" Margin="0,0,0,10"/>

        <ListBox x:Name="LBoxStatuses" Grid.Row="1" Margin="0,0,0,20" 
                 Background="Transparent" BorderThickness="0"
                 SelectionChanged="LBoxStatuses_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#44FFFFFF" CornerRadius="15" Margin="5" Padding="15,5">
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox x:Name="LBoxFilteredBooks" Grid.Row="2" Background="Transparent" BorderThickness="0" MouseDoubleClick="LBoxFilteredBooks_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Image Source="{Binding book.Picture}" Height="60" Width="40" Stretch="UniformToFill"/>
                        <StackPanel Margin="10,0">
                            <TextBlock Text="{Binding book.Name}" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text="{Binding readStatus.Name}" Foreground="Gold" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>