<Page x:Class="WpfApp1.Pages.CarModelAndEngineChoose"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CarModelAndEngineChoose">

    <Grid Background="#FF446B41" OpacityMask="Black">
        <StackPanel>
            <TextBlock x:Name="HelloText" TextAlignment="Center" HorizontalAlignment="Center" Width="296" Margin="25" FontSize="18" Height="21" FontFamily="Arial"><Run Language="ru-ru" Text="Выберите автомобиль"/><LineBreak/><Run Language="ru-ru"/></TextBlock>
            <ComboBox x:Name="CarChoose"  Width="120" SelectionChanged="CarChoose_SelectionChanged"/>
            <TextBlock x:Name="EngineText" Margin="25" TextAlignment="Center" HorizontalAlignment="Center" Width="408"  FontSize="18" Height="23" FontFamily="Arial"><Run Language="ru-ru" Text="Выберите двигатель по количеству ЛС"/><LineBreak/><Run Language="ru-ru"/></TextBlock>
            <ComboBox x:Name="EngineChoose"  Width="120" SelectionChanged="EngineChoose_SelectionChanged"/>
            <Button x:Name="PriceCalculate" HorizontalAlignment="Center" Content="Рассчитать стоимость" Width ="137" Height="39" Margin="25" Click="PriceCalculate_Click"></Button>
            <TextBlock x:Name="PriceText" TextAlignment="Center"  Width="244"  FontSize="18" Height="26" FontFamily="Arial"><Run Language="ru-ru" Text="Итоговая цена: "/><LineBreak/><Run Language="ru-ru"/></TextBlock>
        </StackPanel>
        <Button x:Name="NextButton" Margin="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="100" Height="25" Click="NextButton_Click">Далее</Button>
    </Grid>
</Page>
