<Page x:Class="WpfApp1.Pages.CarModelAndEngineChoose"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CarModelAndEngineChoose">

    <Grid Background="#FF446B41" OpacityMask="Black">
        <StackPanel>
            <TextBlock x:Name="HelloText" TextAlignment="Center" HorizontalAlignment="Center" Width="296" Margin="30" FontSize="18" Height="32" FontFamily="Arial"><Run Language="ru-ru" Text="Выберите автомобиль"/><LineBreak/><Run Language="ru-ru"/></TextBlock>
            <ComboBox x:Name="CarChoose"  Width="120" SelectionChanged="CarChoose_SelectionChanged"/>
            <TextBlock x:Name="EngineText" TextAlignment="Center" HorizontalAlignment="Center" Width="296" Margin="30" FontSize="18" Height="32" FontFamily="Arial"><Run Language="ru-ru" Text="Выберите двигатель"/><LineBreak/><Run Language="ru-ru"/></TextBlock>
            <ComboBox x:Name="EngineChoose"  Width="120" SelectionChanged="CarChoose_SelectionChanged"/>
        </StackPanel>
    </Grid>
</Page>
