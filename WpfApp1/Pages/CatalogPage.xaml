<Page x:Class="WpfApp1.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог книг" Loaded="Page_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="TBoxSearch" Grid.Row="0" Width="300" HorizontalAlignment="Left" 
                 Margin="10" TextChanged="TBoxSearch_TextChanged" />

        <ListBox x:Name="LBoxBooks" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2D2D2D" CornerRadius="8" Margin="10" Width="200" Height="350">
                        <StackPanel>
                            <Image Source="{Binding Picture}" Height="250" Stretch="UniformToFill" Margin="5"/>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" 
                                       FontSize="16" TextAlignment="Center" Margin="5"/>
                            <TextBlock Text="{Binding Rating, StringFormat='Рейтинг: {0}'}" 
                                       Foreground="Gold" TextAlignment="Center"/>
                            <Button Content="Читать" Margin="10,5" Click="BtnRead_Click" Tag="{Binding ID}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>