<Page x:Class="WpfApp1.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1">
    <Grid Background="Black">
        <Border Background="RosyBrown"  Height="45" VerticalAlignment="Top">
            <Grid>
                <TextBlock Text="Кинотеатр Мечта" VerticalAlignment="Center" FontSize="20" HorizontalAlignment="Left" Margin="60,0,0,0" Foreground="White" FontWeight="Bold"></TextBlock>
                <Button Width="50" HorizontalAlignment="Right" Background="{x:Null}" Content="👤" FontSize="20" BorderBrush="{x:Null}" Margin="0,0,60,0" Click="Button_Click"/>
            </Grid>
        </Border>
        <Border CornerRadius="10" Height="25" Background="White" VerticalAlignment="Top" Margin="60,10,10,10" Width="250" HorizontalAlignment="Center">
            <TextBox x:Name="FindFilm" Height="20" Background="Transparent" BorderBrush="Transparent" SelectionBrush="Transparent" Foreground="Black" Margin="10,0,10,0" FontSize="14" TextChanged="FindFilm_TextChanged" />
        </Border>
        <ListBox x:Name="listBox" 
                 Margin="25,70,25,0"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" >

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Карточка товара -->
                    <Border BorderBrush="#E0E0E0" 
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White"
                            Margin="12,8"
                            Width="240"
                            Height="290">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#CCCCCC"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Область картинки -->
                            <Border Grid.Row="0" 
                                    Background="#F8F8F8" 
                                    CornerRadius="6,6,0,0">
                                <Image Height="140" VerticalAlignment="Center" UseLayoutRounding="False" Source="{Binding ImagePath}" Width="240" 
                                       Stretch="Fill"/>
                            </Border>

                            <!-- Информация -->
                            <StackPanel Grid.Row="1" 
                                        Margin="15,10">
                                <TextBlock Text="{Binding Name}" 
                                           HorizontalAlignment="Center" 
                                           TextWrapping="Wrap"
                                           Margin="10"
                                           FontSize="18" 
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="RatingFilm" Text="{Binding Rating}" HorizontalAlignment="Center" FontSize="14"/>
                            </StackPanel>

                            <!-- Кнопка купить билет -->
                            <Button Name="ButSeans"  Grid.Row="2"
                                    Content="Купить билет" 
                                    Margin="10,0,20,15"
                                    Width="143"
                                    HorizontalAlignment="Left"
                                    Padding="10,6"
                                    Tag="{Binding ID}"
                                    Background="DarkOrange"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ButSeans_Click">
                                    
                            </Button>
                            
                            <!-- Кнопка подробнее о фильме -->
                            <Button Name="ButInfo" Grid.Row="2"
                             Content="Подробнее"
                             Margin="20,0,9,15"
                             Width="68"
                             HorizontalAlignment="Right"
                             Padding="1,6"
                             Tag="{Binding ID}"
                             Background="#FFB3947E"
                             Cursor="Hand" Click="ButInfo_Click">
                            </Button>   
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding RatingColorCode}" Value="1">
                            <Setter TargetName="RatingFilm" Property="Foreground" Value="Green"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RatingColorCode}" Value="2">
                            <Setter TargetName="RatingFilm" Property="Foreground" Value="#FFDE9000"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RatingColorCode}" Value="3">
                            <Setter TargetName="RatingFilm" Property="Foreground" Value="#FFFD6800"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RatingColorCode}" Value="4">
                            <Setter TargetName="RatingFilm" Property="Foreground" Value="Red"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
                
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
