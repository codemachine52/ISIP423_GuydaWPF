<Page x:Class="WpfApp1.Pages.Page5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page5">
    
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFB3947E" Offset="0.447"/>
                <GradientStop Color="White" Offset="1"/>
                <GradientStop Color="#FFD9CABF" Offset="0.773"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="420" Height="430" CornerRadius="30" Background="#99822B43">
            <StackPanel>
            <Image Height="150" UseLayoutRounding="False" Source="{Binding ImagePath}" Width="270" Stretch="Fill" Margin="20,30,0,20"/>
                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Description}" FontSize="16" HorizontalAlignment="Center" Margin="10"/>
                <TextBlock x:Name="AgeText" Text="Возрастное ограничение: " FontSize="16" HorizontalAlignment="Center" Margin="15"/>
                <TextBlock x:Name="fGenre" Text="Жанр: " FontSize="18" HorizontalAlignment="Center"/>
                <Button x:Name="TicketBuy" Content="Купить билет" Height="40" Width="180" FontSize="20" Background="PeachPuff" Foreground="Black" Margin="20" Click="TicketBuy_Click" />
            </StackPanel>
        </Border>

        <Button x:Name="GoBack" Content="Назад" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30" FontSize="18" Width="100" Background="#FF713059" Foreground="White" Click="GoBack_Click"/>
    </Grid>
    
</Page>
