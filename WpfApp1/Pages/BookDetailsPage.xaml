<Page x:Class="WpfApp1.Pages.BookDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookDetailsPage">

    <ScrollViewer Background="#1E1E1E">
        <StackPanel Margin="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="{Binding Picture}" Height="350"/>

                <StackPanel Grid.Column="1" Margin="20,0">
                    <TextBlock Text="{Binding Name}" FontSize="32" Foreground="White" FontWeight="Bold"/>
                    <TextBlock Text="{Binding user_.Name, StringFormat='Автор: {0}'}" FontSize="18" Foreground="LightBlue" Margin="0,10"/>
                    <TextBlock Text="{Binding GenresDisplay}" Foreground="Gray"/>
                    <TextBlock x:Name="TxtBlockRating" Text="{Binding Rating, StringFormat='Рейтинг: {0} / 5'}" Foreground="Gold" FontSize="20" Margin="0,10"/>

                    <TextBlock Text="Описание:" Foreground="White" FontWeight="Bold" Margin="0,20,0,5"/>
                    <TextBlock Text="{Binding Description}" Foreground="White" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,30">
                        <Button Content="Читать" Width="120" Height="40" Click="BtnRead_Click" Background="Green" Foreground="White"/>
                        <Button Content="Жалоба на книгу" Margin="10,0" Click="ReportBook_Click"/>
                        <Button Content="Жалоба на автора" Click="ReportAuthor_Click"/>
                        <Button Content="Оставить отзыв" Width="120" Height="40" Margin="10, 0, 0, 0" Background="Violet" Foreground="White" Click="ReviewBut_Click"/>
                        <Button Content="{Binding FreezeActionText}" 
                            Visibility="{Binding AdminVisibility}" 
                            Background="Red" Foreground="White" 
                            Margin="10,0" Click="AdminFreeze_Click"/>
                    </StackPanel>
                    <TextBlock Text="Статус чтения книги:" Foreground="Wheat" FontSize="14" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ComboStatus" Margin="5" SelectedValuePath="ID" DisplayMemberPath="Name" SelectionChanged="ComboStatus_SelectionChanged" Loaded="ComboStatus_Loaded" Tag="{Binding ID}"/>
                </StackPanel>
            </Grid>

            <Separator Margin="0,40"/>
            <TextBlock Text="Отзывы читателей" FontSize="24" Foreground="White" Margin="0,0,0,20"/>

            <ListBox x:Name="LBoxReviews" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#33FFFFFF" Margin="0,5" Padding="15" Width="200">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding user_.Login}" FontWeight="Bold" Foreground="Cyan"/>
                                    <TextBlock Text="{Binding Mark, StringFormat='Оценка: {0}'}" HorizontalAlignment="Right" Foreground="Gold" Margin="20, 0, 0, 0"/>
                                </Grid>
                                <TextBlock Text="{Binding Description}" Foreground="White" Margin="0,10" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Пожаловаться" FontSize="10" Click="ReportReview_Click" Tag="{Binding}"/>
                                    <Button Content="Заморозить (админ)" 
        Visibility="{Binding AdminVisibility}" 
        Click="AdminFreezeReview_Click" 
        Tag="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</Page>
