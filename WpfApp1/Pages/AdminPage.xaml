<Page x:Class="WpfApp1.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Администрирование"
      Loaded="Page_Loaded">
    <Grid>
        <TabControl Background="#1E1E1E" Foreground="Black" BorderThickness="0">
            <TabItem Header="Пользователи">
                <StackPanel Margin="10">
                    <DataGrid x:Name="DGridUsers" 
          AutoGenerateColumns="False" 
          IsReadOnly="True" 
          Height="400"
          Background="Transparent" 
          RowBackground="#20FFFFFF" 
          AlternatingRowBackground="#10FFFFFF"
          Foreground="White" 
          BorderThickness="0"
          GridLinesVisibility="None"
          HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF111111"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding role.Name}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Заморожен" Binding="{Binding IsFreeze}" Width="100"/>
                            <DataGridTemplateColumn Header="Действие" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Сменить пароль" 
                    Click="BtnChangePass_Click" 
                    Tag="{Binding}"
                    Margin="2"
                    Background="#FF27A6AF" 
                    Foreground="White"
                    BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Заявки на разморозку">
                <ListBox x:Name="LBoxUnfreezeRequests">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding TargetName}" FontWeight="Bold" Foreground="#FF27A6AF"/>
                                    <TextBlock Text="{Binding requestText}" TextWrapping="Wrap" Margin="0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Принять (Разморозить)" Click="BtnAcceptUnfreeze_Click" Tag="{Binding}" Margin="0,0,10,0"/>
                                        <Button Content="Отклонить" Click="BtnDeclineUnfreeze_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Заявки на Автора">
                <ListBox x:Name="LBoxRoleRequests">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10">
                                <Grid>
                                    <TextBlock Text="{Binding UserName}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Сделать автором" Click="BtnAcceptAuthor_Click" Tag="{Binding}" Margin="0,0,10,0"/>
                                        <Button Content="Отказать" Click="BtnDeclineAuthor_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
    </Grid>
</Page>