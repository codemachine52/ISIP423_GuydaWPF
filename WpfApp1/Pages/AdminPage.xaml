<Page x:Class="WpfApp1.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Администрирование"
      Loaded="Page_Loaded"
      Background="#1E1E1E">

    <Page.Resources>

        <!-- Стиль таба -->
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground"      Value="#A0A0A0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#27A6AF"/>
                                <Setter TargetName="TabBorder" Property="Background"  Value="#252525"/>
                                <Setter Property="Foreground" Value="#27A6AF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовки колонок DataGrid -->
        <Style x:Key="DarkColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#252525"/>
            <Setter Property="Foreground"      Value="#27A6AF"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderBrush"     Value="#333333"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- Строки DataGrid -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ячейки DataGrid -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#D0D0D0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- RadioButton -->
        <Style x:Key="DarkRadio" TargetType="RadioButton">
            <Setter Property="Foreground"        Value="#A0A0A0"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,16,0"/>
        </Style>

        <!-- Бирюзовая кнопка -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="#1E4A4E"/>
            <Setter Property="Foreground"      Value="#27A6AF"/>
            <Setter Property="BorderBrush"     Value="#27A6AF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#27A6AF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Красная кнопка -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background"      Value="#4A1E1E"/>
            <Setter Property="Foreground"      Value="#E05555"/>
            <Setter Property="BorderBrush"     Value="#E05555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C0392B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Нейтральная кнопка -->
        <Style x:Key="NeutralBtn" TargetType="Button">
            <Setter Property="Background"      Value="#2D2D2D"/>
            <Setter Property="Foreground"      Value="#A0A0A0"/>
            <Setter Property="BorderBrush"     Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCard" TargetType="Border">
            <Setter Property="Background"      Value="#252525"/>
            <Setter Property="BorderBrush"     Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="16,12"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>
    </Page.Resources>

    <Grid>
        <TabControl Background="#1E1E1E" BorderThickness="0"
                    ItemContainerStyle="{StaticResource DarkTabItem}">
            <TabItem Header="Пользователи">
                <Border Background="#1E1E1E" Padding="16,12">
                    <DataGrid x:Name="DGridUsers"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="Transparent"
                              RowBackground="#222222" AlternatingRowBackground="#252525"
                              Foreground="#D0D0D0" BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2A2A2A"
                              HeadersVisibility="Column"
                              ColumnHeaderStyle="{StaticResource DarkColHeader}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}"
                                                IsReadOnly="True" Width="*"/>
                            <DataGridTemplateColumn Header="Роль" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding RoleID, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="id" DisplayMemberPath="Name"
                                                  SelectionChanged="RoleComboBox_SelectionChanged"
                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=AllRoles}"
                                                  Background="#2D2D2D" Foreground="Black"
                                                  BorderBrush="#444444" Margin="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Заморожен" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsFreeze, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  Click="FreezeCheckBox_Click"
                                                  Foreground="#27A6AF"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Действие" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Сменить пароль"
                                                Click="BtnChangePass_Click" Tag="{Binding}"
                                                Style="{StaticResource NeutralBtn}" Margin="4,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            <TabItem Header="Книги">
                <Border Background="#1E1E1E" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#252525" CornerRadius="6"
                                Padding="14,10" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Показать:" Foreground="#666666" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <RadioButton x:Name="RbBooksAll"    Content="Все"
                                             GroupName="BookFilter"  IsChecked="True"
                                             Checked="BookFilter_Changed"
                                             Style="{StaticResource DarkRadio}"/>
                                <RadioButton x:Name="RbBooksActive" Content="✅  Активные"
                                             GroupName="BookFilter"
                                             Checked="BookFilter_Changed"
                                             Style="{StaticResource DarkRadio}"/>
                                <RadioButton x:Name="RbBooksFrozen" Content="🔒  Заморожены"
                                             GroupName="BookFilter"
                                             Checked="BookFilter_Changed"
                                             Style="{StaticResource DarkRadio}" Margin="0"/>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="DGridBooks" Grid.Row="1"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  RowBackground="#222222" AlternatingRowBackground="#252525"
                                  Foreground="#D0D0D0" BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#2A2A2A"
                                  HeadersVisibility="Column"
                                  ColumnHeaderStyle="{StaticResource DarkColHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}"
                                                    Width="*" FontSize="13"/>
                                <DataGridTextColumn Header="Автор"    Binding="{Binding AuthorLogin}"
                                                    Width="160" FontSize="13"/>
                                <DataGridTextColumn Header="Рейтинг"  Binding="{Binding RatingDisplay}"
                                                    Width="90"  FontSize="13"/>
                                <DataGridTemplateColumn Header="Статус" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="8,3" Margin="4,3"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding FreezeBadgeColor, Mode=OneWay}">
                                                <TextBlock Text="{Binding FreezeLabel, Mode=OneWay}"
                                                           Foreground="White" FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Действие" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}"
                                                    Content="{Binding FreezeButtonLabel, Mode=OneWay}"
                                                    Click="BtnToggleBookFreeze_Click"
                                                    Background="{Binding FreezeButtonColor, Mode=OneWay}"
                                                    Foreground="White" BorderThickness="0"
                                                    FontSize="12" Padding="10,5" Margin="4,3"
                                                    Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Жалобы">
                <Border Background="#1E1E1E" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#252525" CornerRadius="6"
                                Padding="14,10" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Показать:" Foreground="#666666" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <RadioButton x:Name="RbAll"      Content="Все"
                                             GroupName="ReportFilter" IsChecked="True"
                                             Checked="ReportFilter_Changed"
                                             Style="{StaticResource DarkRadio}"/>
                                <RadioButton x:Name="RbRepBooks" Content="📖  Книги"
                                             GroupName="ReportFilter"
                                             Checked="ReportFilter_Changed"
                                             Style="{StaticResource DarkRadio}"/>
                                <RadioButton x:Name="RbAuthors"  Content="✍  Авторы"
                                             GroupName="ReportFilter"
                                             Checked="ReportFilter_Changed"
                                             Style="{StaticResource DarkRadio}"/>
                                <RadioButton x:Name="RbReviews"  Content="💬  Отзывы"
                                             GroupName="ReportFilter"
                                             Checked="ReportFilter_Changed"
                                             Style="{StaticResource DarkRadio}" Margin="0"/>
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="LBoxReports" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding"                   Value="0"/>
                                    <Setter Property="Background"                Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DarkCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <Border HorizontalAlignment="Left" CornerRadius="4"
                                                        Padding="8,3" Margin="0,0,0,8"
                                                        Background="{Binding ReportTypeBadgeColor, Mode=OneWay}">
                                                    <TextBlock Text="{Binding ReportTypeLabel, Mode=OneWay}"
                                                               Foreground="White" FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding TargetDescription, Mode=OneWay}"
                                                           Foreground="#E0E0E0" FontWeight="SemiBold"
                                                           FontSize="14" Margin="0,0,0,5"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Foreground="#666666" FontSize="12">
                                                    <Run Text="Жалоба от: "/>
                                                    <Run Text="{Binding ReporterLogin, Mode=OneWay}"
                                                         Foreground="#27A6AF" FontWeight="SemiBold"/>
                                                    <Run Text="  •  "/>
                                                    <Run Text="{Binding ReportDateFormatted, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                                <Button Content="✔  Одобрить"
                                                        Click="BtnAcceptReport_Click" Tag="{Binding}"
                                                        Style="{StaticResource DangerBtn}"
                                                        Margin="0,0,8,0"/>
                                                <Button Content="✖  Отклонить"
                                                        Click="BtnDeclineReport_Click" Tag="{Binding}"
                                                        Style="{StaticResource NeutralBtn}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Разморозка">
                <Border Background="#1E1E1E" Padding="16,12">
                    <ListBox x:Name="LBoxUnfreezeRequests"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding"                   Value="0"/>
                                <Setter Property="Background"                Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DarkCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TargetName}"
                                                   FontWeight="SemiBold" Foreground="#27A6AF"
                                                   FontSize="14" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding requestText}"
                                                   TextWrapping="Wrap" Foreground="#A0A0A0"
                                                   FontSize="13" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Разморозить"
                                                    Click="BtnAcceptUnfreeze_Click" Tag="{Binding}"
                                                    Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="Отклонить"
                                                    Click="BtnDeclineUnfreeze_Click" Tag="{Binding}"
                                                    Style="{StaticResource NeutralBtn}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>
            <TabItem Header="На автора">
                <Border Background="#1E1E1E" Padding="16,12">
                    <ListBox x:Name="LBoxRoleRequests"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding"                   Value="0"/>
                                <Setter Property="Background"                Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DarkCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding UserName}"
                                                   VerticalAlignment="Center" Foreground="#E0E0E0"
                                                   FontSize="14" FontWeight="SemiBold"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Сделать автором"
                                                    Click="BtnAcceptAuthor_Click" Tag="{Binding}"
                                                    Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="Отказать"
                                                    Click="BtnDeclineAuthor_Click" Tag="{Binding}"
                                                    Style="{StaticResource NeutralBtn}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
