<Page x:Class="WpfApp1.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Администрирование"
      Loaded="Page_Loaded">
    <Grid>
        <TabControl Background="#1E1E1E" Foreground="Black" BorderThickness="0">
            <TabItem Header="Пользователи">
                <StackPanel Margin="10">
                    <DataGrid x:Name="DGridUsers" AutoGenerateColumns="False" 
          CanUserAddRows="False"
          Background="Transparent" RowBackground="#20FFFFFF" 
          AlternatingRowBackground="#10FFFFFF" Foreground="White" 
          BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF111111"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" IsReadOnly="True" Width="*"/>

                            <DataGridTemplateColumn Header="Роль" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding RoleID, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="id" DisplayMemberPath="Name" SelectionChanged="RoleComboBox_SelectionChanged" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=AllRoles}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Заморожен" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsFreeze, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Click="FreezeCheckBox_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Действие" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Сменить пароль" Click="BtnChangePass_Click" Tag="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Заявки на разморозку">
                <ListBox x:Name="LBoxUnfreezeRequests">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding TargetName}" FontWeight="Bold" Foreground="#FF27A6AF"/>
                                    <TextBlock Text="{Binding requestText}" TextWrapping="Wrap" Margin="0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Принять (Разморозить)" Click="BtnAcceptUnfreeze_Click" Tag="{Binding}" Margin="0,0,10,0"/>
                                        <Button Content="Отклонить" Click="BtnDeclineUnfreeze_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Заявки на Автора">
                <ListBox x:Name="LBoxRoleRequests">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding UserName}" VerticalAlignment="Center" Foreground="Black" FontSize="14" Margin="10" FontWeight="Bold"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Сделать автором" Click="BtnAcceptAuthor_Click" Tag="{Binding}" Margin="0,0,10,0"/>
                                        <Button Content="Отказать" Click="BtnDeclineAuthor_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
    </Grid>
</Page>