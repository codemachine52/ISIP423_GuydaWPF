<Page x:Class="WpfApp1.Pages.Page7"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page7">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF80502E" Offset="0.447"/>
                <GradientStop Color="#FF442F20" Offset="1"/>
                <GradientStop Color="#FF6F5746" Offset="0.773"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border HorizontalAlignment="Center" Background="#FF7EC3BB" Width="500" Height="400" CornerRadius="10" VerticalAlignment="Top" Margin="25">
            <StackPanel Height="400">
                <Image Source="{Binding Film.ImagePath}" MaxWidth="150" MaxHeight="200" Margin="10"/>
                <TextBlock Text="{Binding Film.Name}" FontSize="18" FontWeight="Black" HorizontalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding sessions}" Margin="20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <Button x:Name="ButSeans" Content="{Binding Time}" Tag="{Binding SessionID}" Click="ButSeans_Click"/>
                                <TextBlock Text="{Binding HallName}" Margin="10,0" FontSize="18"/>
                                <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}" FontSize="18"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Button x:Name="GoBack" Content="Назад" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30" FontSize="18" Width="100" Background="#FFBF4444" Foreground="White" Click="GoBack_Click"/>
    </Grid>
</Page>
